{
  "kind": "distribution",
  "slug": "uniform-distribution",
  "name_zh": "均匀分布",
  "name_en": "Uniform distribution",
  "category": "连续分布",
  "subcategory": "",
  "sort_order": 3,
  "summary": "区间 (a,b) 上取值等可能的连续分布，是几何概型的分布模型。",
  "type": "continuous",
  "support": "x \\in [a,b]",
  "params": [
    {
      "name": "a",
      "latex": "a",
      "description": "区间下端点",
      "default": 0,
      "min": -10,
      "max": 10,
      "step": 0.5
    },
    {
      "name": "b",
      "latex": "b",
      "description": "区间上端点（b>a）",
      "default": 5,
      "min": 1,
      "max": 20,
      "step": 0.5
    }
  ],
  "pmf_or_pdf_latex": "f(x)=\\begin{cases}\\frac{1}{b-a},&a<x<b\\\\0,&\\text{其他}\\end{cases}",
  "cdf_latex": "F(x)=\\begin{cases}0,&x<a\\\\\\frac{x-a}{b-a},&a\\le x<b\\\\1,&x\\ge b\\end{cases}",
  "mean_formula": "E(X)=\\frac{a+b}{2}",
  "variance_formula": "Var(X)=\\frac{(b-a)^2}{12}",
  "mgf_formula": "M_X(t)=\\frac{e^{tb}-e^{ta}}{t(b-a)}",
  "graph_config": {
    "discrete": false,
    "x_range": [
      -5,
      10
    ],
    "default_params": {
      "a": 0,
      "b": 5
    },
    "notes": "区间长度 b-a 恒大于 0"
  },
  "aliases": [
    {
      "alias": "均匀分布",
      "lang": "zh",
      "kind": "name",
      "weight": 100
    },
    {
      "alias": "Uniform distribution",
      "lang": "en",
      "kind": "name",
      "weight": 90
    },
    {
      "alias": "U(a,b)",
      "lang": "math",
      "kind": "notation",
      "weight": 90
    },
    {
      "alias": "X~U(a,b)",
      "lang": "math",
      "kind": "notation",
      "weight": 80
    },
    {
      "alias": "矩形分布",
      "lang": "zh",
      "kind": "alias",
      "weight": 75
    },
    {
      "alias": "continuous uniform",
      "lang": "en",
      "kind": "alias",
      "weight": 60
    }
  ],
  "examples": [
    {
      "title": "等车时间",
      "question": "某路公交车每 10 分钟一班，乘客随机到达车站，求其等车时间超过 6 分钟的概率。",
      "solution": "设等车时间 $X\\sim U(0,10)$，其密度函数为 $f(x)=\\frac{1}{10}$（$0<x<10$）。$P(X>6)=\\frac{10-6}{10}=0.4$。",
      "answer": "$0.4$"
    }
  ]
}
