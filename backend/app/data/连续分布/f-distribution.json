{
  "kind": "distribution",
  "slug": "f-distribution",
  "name_zh": "F 分布",
  "name_en": "F distribution",
  "category": "连续分布",
  "subcategory": "",
  "sort_order": 7,
  "summary": "两个独立卡方变量各自除以自由度后之比构成的分布，方差分析的基础。",
  "type": "continuous",
  "support": "x \\in (0,+\\infty)",
  "params": [
    {
      "name": "m",
      "latex": "m",
      "description": "第一自由度（分子，正整数）",
      "default": 5,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "name": "n",
      "latex": "n",
      "description": "第二自由度（分母，正整数）",
      "default": 10,
      "min": 1,
      "max": 100,
      "step": 1
    }
  ],
  "pmf_or_pdf_latex": "f(x)=\\frac{\\Gamma\\left(\\frac{m+n}{2}\\right)}{\\Gamma\\left(\\frac{m}{2}\\right)\\Gamma\\left(\\frac{n}{2}\\right)}\\left(\\frac{m}{n}\\right)^{\\frac{m}{2}}x^{\\frac{m}{2}-1}\\left(1+\\frac{m}{n}x\\right)^{-\\frac{m+n}{2}},\\quad x>0",
  "cdf_latex": "F(x)=I_{\\frac{mx}{n+mx}}\\left(\\frac{m}{2},\\frac{n}{2}\\right),\\quad x>0",
  "mean_formula": "E(X)=\\frac{n}{n-2},\\quad n>2",
  "variance_formula": "Var(X)=\\frac{2n^2(m+n-2)}{m(n-2)^2(n-4)},\\quad n>4",
  "mgf_formula": "",
  "graph_config": {
    "discrete": false,
    "x_range": [
      0,
      10
    ],
    "default_params": {
      "m": 5,
      "n": 10
    },
    "notes": "若 X~F(m,n)，则 1/X~F(n,m)"
  },
  "aliases": [
    {
      "alias": "F 分布",
      "lang": "zh",
      "kind": "name",
      "weight": 100
    },
    {
      "alias": "F distribution",
      "lang": "en",
      "kind": "name",
      "weight": 90
    },
    {
      "alias": "F(m,n)",
      "lang": "math",
      "kind": "notation",
      "weight": 90
    },
    {
      "alias": "X~F(m,n)",
      "lang": "math",
      "kind": "notation",
      "weight": 80
    },
    {
      "alias": "费歇尔分布",
      "lang": "zh",
      "kind": "alias",
      "weight": 75
    },
    {
      "alias": "Fisher-Snedecor distribution",
      "lang": "en",
      "kind": "alias",
      "weight": 60
    }
  ],
  "examples": [
    {
      "title": "F 分布分位数",
      "question": "设 $X\\sim F(5,10)$，查表得 $F_{0.05}(5,10)=3.33$，求 $P(X>3.33)$，并求 $P\\left(\\frac{1}{X}>\\frac{1}{3.33}\\right)$。",
      "solution": "由分位数定义 $P(X>3.33)=0.05$。利用性质 $\\frac{1}{X}\\sim F(10,5)$：$P\\left(\\frac{1}{X}>\\frac{1}{3.33}\\right)=P(X<3.33)=1-0.05=0.95$。",
      "answer": "$P(X>3.33)=0.05$；$P\\left(\\frac{1}{X}>\\frac{1}{3.33}\\right)=0.95$"
    }
  ]
}
